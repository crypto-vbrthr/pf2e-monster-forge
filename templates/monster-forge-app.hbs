<section class="pf2emf-app">

  <div class="pf2emf-grid">

    <section class="pf2emf-panel pf2emf-basic-panel">
      <h3>{{localize "PF2EMF.Sections.Basic"}}</h3>

      <div class="form-group">
        <label>{{localize "PF2EMF.Fields.Name"}}</label>
        <input type="text" name="name" value="{{data.name}}" />
      </div>

      <div class="pf2emf-two">
        <div class="form-group">
          <label>{{localize "PF2EMF.Fields.Level"}}</label>
          <input type="number" name="level" value="{{data.level}}" min="-1" max="25" />
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Fields.Size"}}</label>
          <select name="size">
            {{selectOptions sizes selected=data.size}}
          </select>
        </div>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EMF.Family"}}</label>
        <select name="family">
          {{selectOptions families selected=data.family}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EMF.Fields.Role"}}</label>
        <select name="role">
          {{selectOptions roles selected=data.role}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EMF.Adjustment"}}</label>
        <select name="adjustment">
          {{selectOptions adjustmentProfiles selected=data.adjustment}}
        </select>
      </div>

      <div class="form-group">
        <label>{{localize "PF2EMF.AttackMode"}}</label>
        <select name="attackProfile">
          {{selectOptions attackProfiles selected=data.attackProfile}}
        </select>
      </div>
    </section>

    <section class="pf2emf-panel pf2emf-designer-panel">
      <h3>{{localize "PF2EMF.Sections.Values"}}</h3>

      <div class="pf2emf-two">
        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.AC"}}</label>
          <select name="ac">{{selectOptions statRanks selected=data.ac}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.HP"}}</label>
          <select name="hp">{{selectOptions statRanks selected=data.hp}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.Perception"}}</label>
          <select name="perception">{{selectOptions statRanks selected=data.perception}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.Fortitude"}}</label>
          <select name="fortitude">{{selectOptions statRanks selected=data.fortitude}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.Reflex"}}</label>
          <select name="reflex">{{selectOptions statRanks selected=data.reflex}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.Will"}}</label>
          <select name="will">{{selectOptions statRanks selected=data.will}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.Attack"}}</label>
          <select name="attack">{{selectOptions statRanks selected=data.attack}}</select>
        </div>

        <div class="form-group">
          <label>{{localize "PF2EMF.Stats.Damage"}}</label>
          <select name="damage">{{selectOptions statRanks selected=data.damage}}</select>
        </div>
      </div>

      <div class="form-group pf2emf-traits">
        <label>{{localize "PF2EMF.Fields.CreatureTraits"}}</label>

        <div class="pf2emf-trait-grid">
          {{#each traits}}
            <label class="pf2emf-trait-pill">
              <input
                type="checkbox"
                name="traits"
                value="{{this.value}}"
                {{#if this.checked}}checked{{/if}}
              />
              <span>{{this.label}}</span>
            </label>
          {{/each}}
        </div>
      </div>

      <details class="pf2emf-collapsible" open>
        <summary>{{localize "PF2EMF.Sections.SpecialAbilities"}}</summary>

        <div class="form-group pf2emf-checkbox-line">
          <label>
            <input
              type="checkbox"
              name="autoAbilities"
              {{#if data.autoAbilities}}checked{{/if}}
            />
            {{localize "PF2EMF.AutoAbilities"}}
          </label>
        </div>

        <div class="pf2emf-trait-grid pf2emf-ability-grid">
          {{#each abilityOptions}}
            <label class="pf2emf-trait-pill">
              <input
                type="checkbox"
                name="selectedAbilities"
                value="{{this.key}}"
                {{#if this.checked}}checked{{/if}}
              />
              <span>{{this.label}}</span>
            </label>
          {{/each}}
        </div>
      </details>
    </section>

    <section class="pf2emf-panel pf2emf-preview">
      <h3>{{localize "PF2EMF.Sections.Preview"}}</h3>

      <div class="pf2emf-title">
        <strong>{{preview.name}}</strong>
        <span>{{localize "PF2EMF.Fields.Level"}} {{preview.level}}</span>
      </div>

      <div class="pf2emf-tags">
        <span>{{preview.family}}</span>
        <span>{{preview.role}}</span>
        <span>{{preview.size}}</span>
        <span>{{preview.adjustment}}</span>
      </div>

      <div class="pf2emf-statline">
        <div><strong>{{localize "PF2EMF.Stats.AC"}}</strong><span>{{preview.ac}}</span></div>
        <div><strong>{{localize "PF2EMF.Stats.HP"}}</strong><span>{{preview.hp}}</span></div>
        <div><strong>{{localize "PF2EMF.Stats.Perception"}}</strong><span>+{{preview.perception}}</span></div>
        <div><strong>{{localize "PF2EMF.Stats.Attack"}}</strong><span>+{{preview.attack}}</span></div>
        <div><strong>{{localize "PF2EMF.Stats.Damage"}}</strong><span>{{preview.damage}}</span></div>
      </div>

      <h4>{{localize "PF2EMF.Sections.Saves"}}</h4>
      <div class="pf2emf-inline">
        <span>{{localize "PF2EMF.Stats.Fortitude"}} +{{preview.saves.fortitude}}</span>
        <span>{{localize "PF2EMF.Stats.Reflex"}} +{{preview.saves.reflex}}</span>
        <span>{{localize "PF2EMF.Stats.Will"}} +{{preview.saves.will}}</span>
      </div>

      <h4>{{localize "PF2EMF.Sections.Abilities"}}</h4>
      <div class="pf2emf-abilities">
        <span>{{localize "PF2EMF.Abilities.STR"}} {{preview.abilities.str}}</span>
        <span>{{localize "PF2EMF.Abilities.DEX"}} {{preview.abilities.dex}}</span>
        <span>{{localize "PF2EMF.Abilities.CON"}} {{preview.abilities.con}}</span>
        <span>{{localize "PF2EMF.Abilities.INT"}} {{preview.abilities.int}}</span>
        <span>{{localize "PF2EMF.Abilities.WIS"}} {{preview.abilities.wis}}</span>
        <span>{{localize "PF2EMF.Abilities.CHA"}} {{preview.abilities.cha}}</span>
      </div>

      {{#if preview.traits.length}}
        <h4>{{localize "PF2EMF.Sections.Traits"}}</h4>
        <div class="pf2emf-tags">
          {{#each preview.traits}}
            <span>{{this}}</span>
          {{/each}}
        </div>
      {{/if}}

      {{#if preview.senses.length}}
        <h4>{{localize "PF2EMF.Sections.Senses"}}</h4>
        <div class="pf2emf-tags">
          {{#each preview.senses}}
            <span>{{this}}</span>
          {{/each}}
        </div>
      {{/if}}

      {{#if preview.speeds}}
        <h4>{{localize "PF2EMF.Sections.Speeds"}}</h4>
        <ul class="pf2emf-list">
          {{#each preview.speeds}}
            <li>{{@key}} {{this}} ft.</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if preview.languages.length}}
        <h4>{{localize "PF2EMF.Sections.Languages"}}</h4>
        <div class="pf2emf-tags">
          {{#each preview.languages}}
            <span>{{this}}</span>
          {{/each}}
        </div>
      {{/if}}

      {{#if preview.resistanceList.length}}
        <h4>{{localize "PF2EMF.Sections.Resistances"}}</h4>
        <ul class="pf2emf-list">
          {{#each preview.resistanceList}}
            <li>{{this.label}} {{this.value}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if preview.weaknessList.length}}
        <h4>{{localize "PF2EMF.Sections.Weaknesses"}}</h4>
        <ul class="pf2emf-list">
          {{#each preview.weaknessList}}
            <li>{{this.label}} {{this.value}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if preview.immunityList.length}}
        <h4>{{localize "PF2EMF.Sections.Immunities"}}</h4>
        <div class="pf2emf-tags">
          {{#each preview.immunityList}}
            <span>{{this.label}}</span>
          {{/each}}
        </div>
      {{/if}}

      {{#if preview.skills}}
        <h4>{{localize "PF2EMF.Sections.Skills"}}</h4>
        <ul class="pf2emf-list">
          {{#each preview.skills}}
            <li>{{this.label}} +{{this.value}}</li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if preview.attacks}}
        <h4>{{localize "PF2EMF.Sections.Attacks"}}</h4>
        <ul class="pf2emf-list">
          {{#each preview.attacks}}
            <li>
              <strong>{{this.name}}</strong>
              <span>+{{this.attack}}</span>
              <span>{{this.damage}} {{this.damageType}}</span>

              {{#if this.traits.length}}
                <small>
                  {{#each this.traits}}
                    {{this}}{{#unless @last}}, {{/unless}}
                  {{/each}}
                </small>
              {{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}

      {{#if preview.specialAbilities.length}}
        <h4>{{localize "PF2EMF.Sections.SpecialAbilities"}}</h4>

        <ul class="pf2emf-list">
          {{#each preview.specialAbilities}}
            <li>
              <strong>{{localize this.name}}</strong>

              {{#if this.actionCost}}
                <span>{{this.actionCost}} {{localize "PF2EMF.Actions.Actions"}}</span>
              {{else}}
                <span>{{localize "PF2EMF.Actions.Passive"}}</span>
              {{/if}}

              {{#if this.dc}}
                <small>{{localize "PF2EMF.Stats.DC"}} {{this.dc}}</small>
              {{/if}}

              {{#if this.damage}}
                <small>{{localize "PF2EMF.Stats.Damage"}} {{this.damage}}</small>
              {{/if}}

              <small>{{localize this.description}}</small>
            </li>
          {{/each}}
        </ul>
      {{/if}}
    </section>

  </div>

  <footer class="pf2emf-footer">
    <button type="button" data-action="preview">
      <i class="fas fa-eye"></i>
      {{localize "PF2EMF.Buttons.Preview"}}
    </button>

    <button type="button" data-action="createActor">
      <i class="fas fa-user-plus"></i>
      {{localize "PF2EMF.Buttons.CreateActor"}}
    </button>
  </footer>

</section>
