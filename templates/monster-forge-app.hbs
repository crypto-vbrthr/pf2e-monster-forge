<section class="pf2emf-app">

  <div class="form-group">
    <label>Name</label>
    <input type="text" name="name" value="{{data.name}}" />
  </div>

  <div class="form-group">
    <label>Level</label>
    <input type="number" name="level" value="{{data.level}}" min="-1" max="25" />
  </div>

  <div class="form-group">
    <label>Rolle</label>
    <select name="role">
      {{selectOptions roles selected=data.role}}
    </select>
  </div>

  <div class="form-group">
    <label>Größe</label>
    <select name="size">
      {{selectOptions sizes selected=data.size}}
    </select>
  </div>

  <hr>

  <h3>Werte</h3>

  <div class="form-group">
    <label>RK</label>
    <select name="ac">
      {{selectOptions statRanks selected=data.ac}}
    </select>
  </div>

  <div class="form-group">
    <label>TP</label>
    <select name="hp">
      {{selectOptions statRanks selected=data.hp}}
    </select>
  </div>

  <div class="form-group">
    <label>Zähigkeit</label>
    <select name="fortitude">
      {{selectOptions statRanks selected=data.fortitude}}
    </select>
  </div>

  <div class="form-group">
    <label>Reflex</label>
    <select name="reflex">
      {{selectOptions statRanks selected=data.reflex}}
    </select>
  </div>

  <div class="form-group">
    <label>Willen</label>
    <select name="will">
      {{selectOptions statRanks selected=data.will}}
    </select>
  </div>

  <div class="form-group">
    <label>Angriff</label>
    <select name="attack">
      {{selectOptions statRanks selected=data.attack}}
    </select>
  </div>

  <div class="form-group">
    <label>Schaden</label>
    <select name="damage">
      {{selectOptions statRanks selected=data.damage}}
    </select>
  </div>

  <hr>

  <h3>Vorschau</h3>

  <div class="pf2emf-preview">
    <p><strong>{{preview.name}}</strong> Stufe {{preview.level}}</p>
    <p>Größe: {{preview.size}}</p>
    <p>RK {{preview.ac}} | TP {{preview.hp}}</p>
    <p>ZÄH {{preview.saves.fortitude}} | REF {{preview.saves.reflex}} | WIL {{preview.saves.will}}</p>
    <p>Angriff +{{preview.attack}} | Schaden {{preview.damage}}</p>
  </div>

  <footer class="sheet-footer flexrow">
    <button type="button" data-action="preview">
      <i class="fas fa-eye"></i>
      Vorschau
    </button>

    <button type="button" data-action="createActor">
      <i class="fas fa-user-plus"></i>
      Actor erstellen
    </button>
  </footer>

</section>
